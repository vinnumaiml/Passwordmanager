<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules: exclude ALL sensitive files.
    NovaVault manages its own encrypted export; Android backup is disabled.
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
